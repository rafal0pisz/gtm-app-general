# Clerk auth — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Without these, Clerk redirects to its hosted "Account Portal"
# (accounts.<your-domain>/sign-in) instead of this app's own /sign-in and
# /sign-up pages.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/

# Anthropic — used by app/api/chat/route.ts via @ai-sdk/anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Tag Manager OAuth client — Google Cloud Console (OAuth consent screen +
# OAuth client ID, type "Web application"). Needs the tagmanager.* scopes
# already requested in app/api/gtm/auth/start/route.ts.
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REDIRECT_URI=

# GCP project + service account JSON (used for Secret Manager / Storage) —
# stores the GTM OAuth token, whitelist and taxonomy reference data.
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Tenant identifier (lib/tenant.ts)
TENANT_ID=
