# Google Tag Manager OAuth client — Google Cloud Console:
# 1. Enable "Tag Manager API" for your project.
# 2. Credentials → Create Credentials → OAuth client ID → "Web application".
# 3. Add GTM_REDIRECT_URI to "Authorized redirect URIs".
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REDIRECT_URI=

# Random long string used to encrypt the Google OAuth token stored in the
# browser's session cookie (lib/gtm-session.ts). No database, no Google Cloud
# Secret Manager — generate one with e.g. `openssl rand -hex 32`.
SESSION_SECRET=
