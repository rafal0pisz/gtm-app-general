# Clerk auth — https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Anthropic — used by app/api/chat/route.ts via @ai-sdk/anthropic — https://console.anthropic.com
ANTHROPIC_API_KEY=

# Google Tag Manager OAuth client — Google Cloud Console
GTM_CLIENT_ID=
GTM_CLIENT_SECRET=
GTM_REDIRECT_URI=

# Stape OAuth app — https://stape.io
STAPE_CLIENT_ID=
STAPE_CLIENT_SECRET=
STAPE_REDIRECT_URI=

# GCP project + service account JSON (used for Secret Manager / Storage)
GCP_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Tenant identifier (lib/tenant.ts)
TENANT_ID=

# Optional debug flag for lib/page-reader.ts
DEBUG_PAGE_READER=
